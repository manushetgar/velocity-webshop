# Copy to .env and adjust. All values are optional.
PORT=3001

# SQLite file location
DB_FILE=./data/webshop.db

# Admin account created on first start (only if no admin exists yet).
# Change the password before showing the shop to anyone.
ADMIN_EMAIL=admin@webshop.local
ADMIN_PASSWORD=admin123

# Demo customer account created on first start (shown on the login page in demo mode)
DEMO_CUSTOMER_EMAIL=customer@webshop.local
DEMO_CUSTOMER_PASSWORD=customer123
# Set to false to hide the demo accounts on the login page
DEMO_MODE=true

# Session lifetime in hours
SESSION_TTL_HOURS=24

# ---------------------------------------------------------------
# SAP connectors (Mini-ERP connections)
# The ERP systems are managed in the shop: Admin > SAP connectors
# (add, edit, test, switch with "Use this ERP", disconnect).
# The values below only fill the connector list on the FIRST start
# (empty database). Later changes are made in the admin UI.
# ---------------------------------------------------------------

# Local ERP started with `cds watch` - always created, active by default.
# Users are the mocked users from the ERP lab description.
# LOCAL_ERP_URL=http://localhost:4004
# LOCAL_ERP_USER=service-user
# LOCAL_ERP_PASSWORD=service-user

# ERP deployed on SAP BTP (creates the connector "SAP BTP (Cloud Foundry)").
# Create the key file once (in a terminal logged in with cf):
#    cf create-service-key simple-erp-auth-api webshop-key
#    cf service-key simple-erp-auth-api webshop-key | sed -n '/^{/,$p' > xsuaa-key.json
#    The key file contains a client secret: never commit it (it is in .gitignore).
# ERP_URL=https://<org>-<space>-simple-erp-srv.cfapps.us10-001.hana.ondemand.com
# ERP_XSUAA_KEY_FILE=./xsuaa-key.json

# Connector that is active on the first start: local (default), btp or none
# ERP_ACTIVE=local

# Create orders in the ERP at checkout (default true when a connector is active)
# ERP_ORDERS=true
# Sync products and order statuses when the server starts (default true)
# ERP_SYNC_ON_START=true
# Sync interval in seconds (default 60, 0 = off)
# ERP_SYNC_INTERVAL_S=60
# Timeout per ERP call in ms
# ERP_TIMEOUT_MS=10000

# ---------------------------------------------------------------
# Lab 2: file transfer (Admin > File transfer)
# Switch a connector to file transfer in Admin > File transfer or in
# its Edit dialog ("Product data reaches the shop via").
# ---------------------------------------------------------------
# Transfer folder with the sub folders inbox/, processed/, error/ (default ./transfer, i.e. server/transfer)
# FILE_TRANSFER_DIR=./transfer
# How often the inbox is checked for new files, in seconds (default 10, 0 = off)
# FILE_POLL_INTERVAL_S=10
# A file must be unchanged this long before the poller imports it (half-copied files), in ms
# FILE_SETTLE_MS=2000
# How many files are kept in processed/ and error/
# FILE_KEEP=200
# The ERP export job runs with ERP_SYNC_INTERVAL_S (see above) and writes a file only when the ERP data changed.

# ---------------------------------------------------------------
# Lab 2 extension: suppliers (Admin > Suppliers)
# Suppliers deliver product files in their own format through the
# supplier portal or FTP; the shop writes them into the ERP.
# ---------------------------------------------------------------
# Supplier portal (separate site) - 0 = only under /portal/ of the shop
# PORTAL_PORT=3200
# FTP server for supplier systems - 0 = off. Plain FTP, passive mode, only local by default.
# FTP_PORT=2121
# FTP_HOST=127.0.0.1
# Fixed range for passive data ports (only needed behind a firewall), e.g. 2122-2140
# FTP_PASV_MIN=
# FTP_PASV_MAX=
# Password of the demo supplier logins (bikeparts, globalcycle, nordicgear, celticparts), set on the first start
SUPPLIER_DEMO_PASSWORD=supplier123
# Files waiting because the ERP was not reachable are retried every N seconds
# SUPPLIER_RETRY_S=30
# Currencies the shop sells in (supplier prices in other currencies are rejected)
# SHOP_CURRENCIES=EUR
